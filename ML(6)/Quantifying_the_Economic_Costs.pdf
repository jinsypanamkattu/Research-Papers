         <xmpMM:DocumentID>uuid:39709eb7-bf39-11b2-0a00-64ccfdff0000</xmpMM:DocumentID>
         <xmpMM:InstanceID>uuid:39710a76-bf39-11b2-0a00-f1ccfdff0000</xmpMM:InstanceID>
